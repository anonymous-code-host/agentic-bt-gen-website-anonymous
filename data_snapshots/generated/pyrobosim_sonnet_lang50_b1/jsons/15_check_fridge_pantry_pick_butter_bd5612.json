{
  "root": {
    "type": "selector",
    "name": "Check fridge then pantry for butter",
    "memory": true,
    "children": [
      {
        "type": "sequence",
        "name": "Check fridge for butter",
        "memory": true,
        "children": [
          {
            "type": "action",
            "name": "Navigate to fridge",
            "action": "navigate",
            "params": {
              "target_location": "fridge"
            }
          },
          {
            "type": "action",
            "name": "Open fridge",
            "action": "open"
          },
          {
            "type": "action",
            "name": "Detect butter in fridge",
            "action": "detect",
            "params": {
              "object": "butter"
            },
            "outputs": {
              "detected_objects": "fridge_detected_objects"
            }
          },
          {
            "type": "action",
            "name": "Pick butter from fridge",
            "action": "pick",
            "params": {
              "object": "butter"
            }
          }
        ]
      },
      {
        "type": "sequence",
        "name": "Check pantry for butter",
        "memory": true,
        "children": [
          {
            "type": "action",
            "name": "Close fridge",
            "action": "close",
            "params": {
              "target_location": "fridge"
            }
          },
          {
            "type": "action",
            "name": "Navigate to pantry",
            "action": "navigate",
            "params": {
              "target_location": "pantry"
            }
          },
          {
            "type": "action",
            "name": "Open pantry",
            "action": "open"
          },
          {
            "type": "action",
            "name": "Detect butter in pantry",
            "action": "detect",
            "params": {
              "object": "butter"
            },
            "outputs": {
              "detected_objects": "pantry_detected_objects"
            }
          },
          {
            "type": "action",
            "name": "Pick butter from pantry",
            "action": "pick",
            "params": {
              "object": "butter"
            }
          }
        ]
      }
    ]
  }
}