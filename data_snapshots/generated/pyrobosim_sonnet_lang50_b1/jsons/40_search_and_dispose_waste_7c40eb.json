{
  "blackboard": {
    "initial": {
      "detected_objects": []
    }
  },
  "root": {
    "type": "sequence",
    "memory": true,
    "name": "Search and dispose waste",
    "children": [
      {
        "type": "selector",
        "memory": true,
        "name": "Find and pick waste from bin or desk",
        "children": [
          {
            "type": "sequence",
            "memory": true,
            "name": "Try bin_disposal",
            "children": [
              {
                "type": "action",
                "name": "Navigate to bin_disposal",
                "action": "navigate",
                "params": {
                  "target_location": "bin_disposal"
                }
              },
              {
                "type": "action",
                "name": "Detect waste at bin_disposal",
                "action": "detect",
                "params": {
                  "object": "waste"
                },
                "outputs": {
                  "detected_objects": "detected_objects"
                }
              },
              {
                "type": "condition",
                "name": "Waste found at bin?",
                "key": "detected_objects",
                "operator": "truthy",
                "value": true
              },
              {
                "type": "action",
                "name": "Pick waste from bin",
                "action": "pick",
                "params": {
                  "object": "waste"
                }
              }
            ]
          },
          {
            "type": "sequence",
            "memory": true,
            "name": "Try desk_desktop",
            "children": [
              {
                "type": "action",
                "name": "Navigate to desk_desktop",
                "action": "navigate",
                "params": {
                  "target_location": "desk_desktop"
                }
              },
              {
                "type": "action",
                "name": "Detect waste at desk_desktop",
                "action": "detect",
                "params": {
                  "object": "waste"
                },
                "outputs": {
                  "detected_objects": "detected_objects"
                }
              },
              {
                "type": "condition",
                "name": "Waste found at desk?",
                "key": "detected_objects",
                "operator": "truthy",
                "value": true
              },
              {
                "type": "action",
                "name": "Pick waste from desk",
                "action": "pick",
                "params": {
                  "object": "waste"
                }
              }
            ]
          }
        ]
      },
      {
        "type": "action",
        "name": "Navigate to dumpster_disposal",
        "action": "navigate",
        "params": {
          "target_location": "dumpster_disposal"
        }
      },
      {
        "type": "action",
        "name": "Place waste at dumpster",
        "action": "place",
        "params": {}
      }
    ]
  }
}