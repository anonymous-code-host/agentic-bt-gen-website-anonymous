{
  "root": {
    "type": "sequence",
    "memory": true,
    "children": [
      {
        "type": "action",
        "name": "Navigate to Fridge",
        "action": "navigate",
        "params": {
          "target_location": "fridge"
        },
        "outputs": {
          "status": "nav_status",
          "message": "nav_message"
        }
      },
      {
        "type": "action",
        "name": "Open Fridge",
        "action": "open",
        "outputs": {
          "status": "open_status",
          "message": "open_message"
        }
      },
      {
        "type": "action",
        "name": "Detect Butter",
        "action": "detect",
        "params": {
          "object": "butter"
        },
        "outputs": {
          "status": "detect_status",
          "message": "detect_message",
          "detected_objects": "detected_objects"
        }
      },
      {
        "type": "action",
        "name": "Pick Butter",
        "action": "pick",
        "params": {
          "object": "butter"
        },
        "outputs": {
          "status": "pick_status",
          "message": "pick_message"
        }
      }
    ]
  }
}