{
  "root": {
    "type": "sequence",
    "memory": true,
    "children": [
      {
        "type": "action",
        "name": "Navigate to pantry",
        "action": "navigate",
        "params": {
          "target_location": "pantry"
        },
        "outputs": {
          "status": "nav_pantry_status"
        }
      },
      {
        "type": "action",
        "name": "Open pantry",
        "action": "open",
        "outputs": {
          "status": "open_status"
        }
      },
      {
        "type": "action",
        "name": "Detect snacks",
        "action": "detect",
        "params": {
          "object": "snacks"
        },
        "outputs": {
          "status": "detect_status",
          "detected_objects": "detected_objects"
        }
      },
      {
        "type": "condition",
        "name": "Check snacks detected",
        "key": "detected_objects",
        "operator": "truthy",
        "value": true
      },
      {
        "type": "action",
        "name": "Pick snacks",
        "action": "pick",
        "params": {
          "object": "snacks"
        },
        "outputs": {
          "status": "pick_status"
        }
      },
      {
        "type": "action",
        "name": "Navigate to kitchen",
        "action": "navigate",
        "params": {
          "target_location": "kitchen"
        },
        "outputs": {
          "status": "nav_kitchen_status"
        }
      }
    ]
  }
}