<root BTCPP_format="4">
  <BehaviorTree ID="MainTree">
    <Fallback name="root_fallback">
      <RetryUntilSuccessful num_attempts="3">
        <Fallback name="attempt_fallback">
          <NavigateToLocation location="elevator"/>
          <Sequence name="recovery_seq">
            <BackUp backup_dist="0.3"/>
            <Wait wait_duration="2.0"/>
            <ForceFailure>
              <AlwaysSuccess/>
            </ForceFailure>
          </Sequence>
        </Fallback>
      </RetryUntilSuccessful>
      <NavigateToLocation location="nrg_entrance"/>
    </Fallback>
  </BehaviorTree>
  <TreeNodesModel>
    <Action ID="NavigateToLocation">
      <input_port name="location"/>
    </Action>
    <Action ID="BackUp">
      <input_port name="backup_dist"/>
      <input_port name="backup_speed"/>
      <input_port name="time_allowance"/>
    </Action>
    <Action ID="Wait">
      <input_port name="wait_duration"/>
    </Action>
  </TreeNodesModel>
</root>