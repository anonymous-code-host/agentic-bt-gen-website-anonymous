{
  "blackboard": {
    "initial": {
      "true_flag": true
    }
  },
  "root": {
    "type": "sequence",
    "memory": true,
    "children": [
      {
        "type": "action",
        "name": "Navigate to bin_disposal",
        "action": "navigate",
        "params": {
          "target_location": "bin_disposal"
        }
      },
      {
        "type": "selector",
        "memory": true,
        "children": [
          {
            "type": "sequence",
            "memory": true,
            "children": [
              {
                "type": "action",
                "name": "Detect waste at bin_disposal",
                "action": "detect",
                "params": {
                  "object": "waste"
                },
                "outputs": {
                  "detected_objects": "detected_at_bin"
                }
              },
              {
                "type": "action",
                "name": "Pick waste at bin_disposal",
                "action": "pick",
                "params": {
                  "object": "waste"
                }
              },
              {
                "type": "action",
                "name": "Navigate to dumpster_disposal from bin",
                "action": "navigate",
                "params": {
                  "target_location": "dumpster_disposal"
                }
              },
              {
                "type": "action",
                "name": "Place waste at dumpster_disposal",
                "action": "place",
                "params": {}
              }
            ]
          },
          {
            "type": "condition",
            "name": "No waste at bin - continue",
            "key": "true_flag",
            "operator": "==",
            "value": true
          }
        ]
      },
      {
        "type": "action",
        "name": "Navigate to desk_desktop",
        "action": "navigate",
        "params": {
          "target_location": "desk_desktop"
        }
      },
      {
        "type": "selector",
        "memory": true,
        "children": [
          {
            "type": "sequence",
            "memory": true,
            "children": [
              {
                "type": "action",
                "name": "Detect waste at desk_desktop",
                "action": "detect",
                "params": {
                  "object": "waste"
                },
                "outputs": {
                  "detected_objects": "detected_at_desk"
                }
              },
              {
                "type": "action",
                "name": "Pick waste at desk_desktop",
                "action": "pick",
                "params": {
                  "object": "waste"
                }
              },
              {
                "type": "action",
                "name": "Navigate to dumpster_disposal from desk",
                "action": "navigate",
                "params": {
                  "target_location": "dumpster_disposal"
                }
              },
              {
                "type": "action",
                "name": "Place waste at dumpster_disposal",
                "action": "place",
                "params": {}
              }
            ]
          },
          {
            "type": "condition",
            "name": "No waste at desk - done",
            "key": "true_flag",
            "operator": "==",
            "value": true
          }
        ]
      }
    ]
  }
}