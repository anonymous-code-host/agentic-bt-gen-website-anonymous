{
  "root": {
    "type": "sequence",
    "memory": true,
    "children": [
      {
        "type": "action",
        "name": "Navigate to Fridge",
        "action": "navigate",
        "params": {
          "target_location": "fridge"
        },
        "outputs": {
          "status": "nav_fridge_status"
        }
      },
      {
        "type": "action",
        "name": "Open Fridge",
        "action": "open",
        "outputs": {
          "status": "open_status"
        }
      },
      {
        "type": "action",
        "name": "Detect Soda",
        "action": "detect",
        "params": {
          "object": "soda"
        },
        "outputs": {
          "status": "detect_status",
          "detected_objects": "detected_objects"
        }
      },
      {
        "type": "action",
        "name": "Pick Soda",
        "action": "pick",
        "params": {
          "object": "soda"
        },
        "outputs": {
          "status": "pick_status"
        }
      },
      {
        "type": "action",
        "name": "Navigate to Office",
        "action": "navigate",
        "params": {
          "target_location": "office"
        },
        "outputs": {
          "status": "nav_office_status"
        }
      }
    ]
  }
}