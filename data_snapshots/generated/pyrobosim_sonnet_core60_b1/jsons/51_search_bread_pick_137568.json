            }
          },
          {
            "type": "condition",
            "name": "BreadFoundAtFridge",
            "key": "fridge_detected_objects",
            "operator": "truthy",
            "value": true
          },
          {
            "type": "action",
            "name": "PickBreadFromFridge",
            "action": "pick",
            "params": {
              "object": "bread"
            },
            "outputs": {
              "status": "pick_fridge_status"
