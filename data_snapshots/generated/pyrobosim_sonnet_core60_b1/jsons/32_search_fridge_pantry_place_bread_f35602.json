{
  "root": {
    "type": "sequence",
    "memory": true,
    "children": [
      {
        "name": "Find and pick bread",
        "type": "selector",
        "memory": true,
        "children": [
          {
            "name": "Search fridge for bread",
            "type": "sequence",
            "memory": true,
            "children": [
              {
                "type": "action",
                "name": "Navigate to fridge",
                "action": "navigate",
                "params": {
                  "target_location": "fridge"
                }
              },
              {
                "type": "action",
                "name": "Open fridge",
                "action": "open"
              },
              {
                "type": "action",
                "name": "Detect bread in fridge",
                "action": "detect",
                "params": {
                  "object": "bread"
                },
                "outputs": {
                  "detected_objects": "fridge_detected_objects"
                }
              },
              {
                "type": "action",
                "name": "Pick bread from fridge",
                "action": "pick",
                "params": {
                  "object": "bread"
                }
              }
            ]
          },
          {
            "name": "Search pantry for bread",
            "type": "sequence",
            "memory": true,
            "children": [
              {
                "type": "action",
                "name": "Close fridge",
                "action": "close",
                "params": {
                  "target_location": "fridge"
                }
              },
              {
                "type": "action",
                "name": "Navigate to pantry",
                "action": "navigate",
                "params": {
                  "target_location": "pantry"
                }
              },
              {
                "type": "action",
                "name": "Open pantry",
                "action": "open"
              },
              {
                "type": "action",
                "name": "Detect bread in pantry",
                "action": "detect",
                "params": {
                  "object": "bread"
                },
                "outputs": {
                  "detected_objects": "pantry_detected_objects"
                }
              },
              {
                "type": "action",
                "name": "Pick bread from pantry",
                "action": "pick",
                "params": {
                  "object": "bread"
                }
              }
            ]
          }
        ]
      },
      {
        "type": "action",
        "name": "Navigate to table",
        "action": "navigate",
        "params": {
          "target_location": "table"
        }
      },
      {
        "type": "action",
        "name": "Place bread on table_tabletop",
        "action": "place"
      }
    ]
  }
}