{
  "root": {
    "type": "sequence",
    "memory": true,
    "children": [
      {
        "name": "Find waste at bin_disposal or desk_desktop",
        "type": "selector",
        "memory": true,
        "children": [
          {
            "name": "Search bin_disposal for waste",
            "type": "sequence",
            "memory": true,
            "children": [
              {
                "name": "Navigate to bin_disposal",
                "type": "action",
                "action": "navigate",
                "params": {
                  "target_location": "bin_disposal"
                },
                "outputs": {
                  "status": "nav_status"
                }
              },
              {
                "name": "Detect waste at bin_disposal",
                "type": "action",
                "action": "detect",
                "params": {
                  "object": "waste"
                },
                "outputs": {
                  "detected_objects": "detected_objects",
                  "status": "detect_status"
                }
              },
              {
                "name": "Check waste found at bin_disposal",
                "type": "condition",
                "key": "detected_objects",
                "operator": "truthy",
                "value": true
              }
            ]
          },
          {
            "name": "Search desk_desktop for waste",
            "type": "sequence",
            "memory": true,
            "children": [
              {
                "name": "Navigate to desk_desktop",
                "type": "action",
                "action": "navigate",
                "params": {
                  "target_location": "desk_desktop"
                },
                "outputs": {
                  "status": "nav_status"
                }
              },
              {
                "name": "Detect waste at desk_desktop",
                "type": "action",
                "action": "detect",
                "params": {
                  "object": "waste"
                },
                "outputs": {
                  "detected_objects": "detected_objects",
                  "status": "detect_status"
                }
              },
              {
                "name": "Check waste found at desk_desktop",
                "type": "condition",
                "key": "detected_objects",
                "operator": "truthy",
                "value": true
              }
            ]
          }
        ]
      },
      {
        "name": "Pick up waste",
        "type": "action",
        "action": "pick",
        "params": {
          "object": "waste"
        },
        "outputs": {
          "status": "pick_status"
        }
      },
      {
        "name": "Navigate to dining",
        "type": "action",
        "action": "navigate",
        "params": {
          "target_location": "dining"
        },
        "outputs": {
          "status": "nav_status"
        }
      }
    ]
  }
}