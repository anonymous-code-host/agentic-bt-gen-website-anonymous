{
  "root": {
    "type": "sequence",
    "memory": true,
    "children": [
      {
        "type": "action",
        "name": "Navigate to pantry",
        "action": "navigate",
        "params": {
          "target_location": "pantry"
        },
        "outputs": {
          "status": "nav_pantry_status"
        }
      },
      {
        "type": "action",
        "name": "Open pantry",
        "action": "open",
        "outputs": {
          "status": "open_status"
        }
      },
      {
        "type": "action",
        "name": "Detect snacks in pantry",
        "action": "detect",
        "params": {
          "object": "snacks"
        },
        "outputs": {
          "status": "detect_status",
          "detected_objects": "detected_snacks"
        }
      },
      {
        "type": "action",
        "name": "Pick up snacks",
        "action": "pick",
        "params": {
          "object": "snacks"
        },
        "outputs": {
          "status": "pick_status"
        }
      },
      {
        "type": "action",
        "name": "Navigate to desk",
        "action": "navigate",
        "params": {
          "target_location": "desk"
        },
        "outputs": {
          "status": "nav_desk_status"
        }
      },
      {
        "type": "action",
        "name": "Place snacks on desk_desktop",
        "action": "place",
        "outputs": {
          "status": "place_status"
        }
      }
    ]
  }
}