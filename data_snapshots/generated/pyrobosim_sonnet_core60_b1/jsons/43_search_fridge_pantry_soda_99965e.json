                "action": "open"
              },
              {
                "type": "selector",
                "memory": true,
                "name": "Get soda from pantry or finish gracefully",
                "children": [
                  {
                    "type": "sequence",
                    "memory": true,
                    "name": "Get soda from pantry",
                    "children": [
                      {
                        "type": "action",
                        "name": "Detect soda in pantry",
                        "action": "detect",
                        "params": {
                          "object": "soda"
                        }
                      },
                      {
                        "type": "action",
                        "name": "Pick soda from pantry",
                        "action": "pick",
                        "params": {
                          "object": "soda"
                        }
                      },
                      {
                        "type": "action",
