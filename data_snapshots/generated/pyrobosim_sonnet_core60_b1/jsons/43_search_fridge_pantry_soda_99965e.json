        "action": "navigate",
        "params": {
          "target_location": "fridge"
        }
      },
      {
        "type": "action",
        "name": "Open fridge",
        "action": "open"
      },
      {
        "type": "selector",
        "memory": true,
        "name": "Find and retrieve soda",
        "children": [
          {
            "type": "sequence",
            "memory": true,
            "name": "Get soda from fridge",
            "children": [
              {
                "type": "action",
                "name": "Detect soda in fridge",
                "action": "detect",
                "params": {
                  "object": "soda"
                }
              },
              {
                "type": "action",
                "name": "Pick soda from fridge",
                "action": "pick",
                "params": {
                  "object": "soda"
                }
              },
              {
                "type": "action",
                "name": "Navigate to dining",
                "action": "navigate",
                "params": {
                  "target_location": "dining"
                }
              }
            ]
          },
          {
            "type": "sequence",
            "memory": true,
            "name": "Try pantry for soda",
            "children": [
              {
                "type": "action",
                "name": "Close fridge",
                "action": "close"
              },
              {
                "type": "action",
                "name": "Navigate to pantry",
                "action": "navigate",
                "params": {
                  "target_location": "pantry"
                }
              },
              {
                "type": "action",
