{
  "root": {
    "type": "sequence",
    "memory": true,
    "children": [
      {
        "type": "action",
        "name": "Navigate to fridge",
        "action": "navigate",
        "params": {
          "target_location": "fridge"
        },
        "outputs": {
          "status": "nav_status",
          "last_nav_result": "last_nav_result"
        }
      },
      {
        "type": "action",
        "name": "Open fridge",
        "action": "open",
        "outputs": {
          "status": "open_status"
        }
      },
      {
        "type": "action",
        "name": "Detect butter",
        "action": "detect",
        "params": {
          "object": "butter"
        },
        "outputs": {
          "status": "detect_status",
          "detected_objects": "detected_objects"
        }
      },
      {
        "type": "action",
        "name": "Pick butter",
        "action": "pick",
        "params": {
          "object": "butter"
        },
        "outputs": {
          "status": "pick_status",
          "message": "pick_message"
        }
      }
    ]
  }
}