{
  "root": {
    "type": "selector",
    "memory": true,
    "children": [
      {
        "name": "Search pantry for snacks",
        "type": "sequence",
        "memory": true,
        "children": [
          {
            "type": "action",
            "name": "Navigate to pantry",
            "action": "navigate",
            "params": {
              "target_location": "pantry"
            },
            "outputs": {
              "status": "nav_pantry_status"
            }
          },
          {
            "type": "action",
            "name": "Open pantry",
            "action": "open",
            "outputs": {
              "status": "open_pantry_status"
            }
          },
          {
            "type": "action",
            "name": "Detect snacks in pantry",
            "action": "detect",
            "params": {
              "object": "snacks"
            },
            "outputs": {
              "detected_objects": "pantry_detected_objects",
              "status": "detect_pantry_status"
            }
          },
          {
            "type": "action",
            "name": "Pick snacks from pantry",
            "action": "pick",
            "params": {
              "object": "snacks"
            },
            "outputs": {
              "status": "pick_status"
            }
          }
        ]
      },
      {
        "name": "Search fridge for snacks",
        "type": "sequence",
        "memory": true,
        "children": [
          {
            "type": "action",
            "name": "Navigate to fridge",
            "action": "navigate",
            "params": {
              "target_location": "fridge"
            },
            "outputs": {
              "status": "nav_fridge_status"
            }
          },
          {
            "type": "action",
            "name": "Open fridge",
            "action": "open",
            "outputs": {
              "status": "open_fridge_status"
            }
          },
          {
            "type": "action",
            "name": "Detect snacks in fridge",
            "action": "detect",
            "params": {
              "object": "snacks"
            },
            "outputs": {
              "detected_objects": "fridge_detected_objects",
              "status": "detect_fridge_status"
            }
          },
          {
            "type": "action",
            "name": "Pick snacks from fridge",
            "action": "pick",
            "params": {
              "object": "snacks"
            },
            "outputs": {
              "status": "pick_status"
            }
          }
        ]
      }
    ]
  }
}