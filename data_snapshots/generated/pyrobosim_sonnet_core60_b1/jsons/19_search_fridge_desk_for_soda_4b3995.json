{
  "root": {
    "type": "selector",
    "memory": true,
    "name": "Search fridge then desk for soda",
    "children": [
      {
        "type": "sequence",
        "memory": true,
        "name": "Search fridge for soda",
        "children": [
          {
            "type": "action",
            "name": "Navigate to fridge",
            "action": "navigate",
            "params": {
              "target_location": "fridge"
            }
          },
          {
            "type": "action",
            "name": "Open fridge",
            "action": "open"
          },
          {
            "type": "action",
            "name": "Detect soda at fridge",
            "action": "detect",
            "params": {
              "object": "soda"
            },
            "outputs": {
              "detected_objects": "fridge_detected"
            }
          },
          {
            "type": "action",
            "name": "Pick soda from fridge",
            "action": "pick",
            "params": {
              "object": "soda"
            }
          }
        ]
      },
      {
        "type": "sequence",
        "memory": true,
        "name": "Search desk_desktop for soda",
        "children": [
          {
            "type": "action",
            "name": "Navigate to desk_desktop",
            "action": "navigate",
            "params": {
              "target_location": "desk_desktop"
            }
          },
          {
            "type": "action",
            "name": "Detect soda at desk",
            "action": "detect",
            "params": {
              "object": "soda"
            },
            "outputs": {
              "detected_objects": "desk_detected"
            }
          },
          {
            "type": "action",
            "name": "Pick soda from desk",
            "action": "pick",
            "params": {
              "object": "soda"
            }
          }
        ]
      }
    ]
  }
}