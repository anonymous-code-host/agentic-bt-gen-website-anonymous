                "params": {
                  "object": "bread"
                },
                "outputs": {
                  "detected_objects": "detected_objects"
                }
              },
              {
                "type": "condition",
                "name": "Bread found in pantry?",
                "key": "detected_objects",
                "operator": "truthy",
                "value": true
              }
            ]
          },
          {
            "type": "sequence",
            "memory": true,
            "name": "Search fridge for bread",
            "children": [
              {
                "type": "action",
                "name": "Close pantry",
                "action": "close",
                "params": {
                  "target_location": "pantry"
                }
              },
              {
                "type": "action",
                "name": "Navigate to fridge",
                "action": "navigate",
                "params": {
                  "target_location": "fridge"
                }
              },
              {
                "type": "action",
                "name": "Open fridge",
                "action": "open"
              },
              {
