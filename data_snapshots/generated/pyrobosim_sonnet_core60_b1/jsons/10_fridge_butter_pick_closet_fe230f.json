{
  "root": {
    "type": "sequence",
    "memory": true,
    "children": [
      {
        "type": "action",
        "name": "Navigate to fridge",
        "action": "navigate",
        "params": {
          "target_location": "fridge"
        },
        "outputs": {
          "status": "nav_fridge_status"
        }
      },
      {
        "type": "action",
        "name": "Open fridge",
        "action": "open",
        "outputs": {
          "status": "open_status"
        }
      },
      {
        "type": "action",
        "name": "Detect butter",
        "action": "detect",
        "params": {
          "object": "butter"
        },
        "outputs": {
          "detected_objects": "detected_objects",
          "status": "detect_status"
        }
      },
      {
        "type": "condition",
        "name": "Butter detected?",
        "key": "detected_objects",
        "operator": "contains",
        "value": "butter0"
      },
      {
        "type": "action",
        "name": "Pick butter",
        "action": "pick",
        "params": {
          "object": "butter0"
        },
        "outputs": {
          "status": "pick_status"
        }
      },
      {
        "type": "action",
        "name": "Navigate to closet",
        "action": "navigate",
        "params": {
          "target_location": "closet"
        },
        "outputs": {
          "status": "nav_closet_status"
        }
      }
    ]
  }
}