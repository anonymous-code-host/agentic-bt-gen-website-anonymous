{
  "root": {
    "name": "Search desk then bin for waste and pick if found",
    "type": "selector",
    "memory": true,
    "children": [
      {
        "name": "Search desk_desktop and pick waste",
        "type": "sequence",
        "memory": true,
        "children": [
          {
            "type": "action",
            "name": "Navigate to desk_desktop",
            "action": "navigate",
            "params": {
              "target_location": "desk_desktop"
            },
            "outputs": {
              "status": "nav_desk_status",
              "last_nav_result": "nav_desk_result"
            }
          },
          {
            "type": "action",
            "name": "Detect waste at desk_desktop",
            "action": "detect",
            "params": {
              "object": "waste"
            },
            "outputs": {
              "status": "detect_desk_status",
              "detected_objects": "detected_desk_objects"
            }
          },
          {
            "type": "action",
            "name": "Pick waste at desk_desktop",
            "action": "pick",
            "params": {
              "object": "waste"
            },
            "outputs": {
              "status": "pick_desk_status"
            }
          }
        ]
      },
      {
        "name": "Search bin_disposal and pick waste",
        "type": "sequence",
        "memory": true,
        "children": [
          {
            "type": "action",
            "name": "Navigate to bin_disposal",
            "action": "navigate",
            "params": {
              "target_location": "bin_disposal"
            },
            "outputs": {
              "status": "nav_bin_status",
              "last_nav_result": "nav_bin_result"
            }
          },
          {
            "type": "action",
            "name": "Detect waste at bin_disposal",
            "action": "detect",
            "params": {
              "object": "waste"
            },
            "outputs": {
              "status": "detect_bin_status",
              "detected_objects": "detected_bin_objects"
            }
          },
          {
            "type": "action",
            "name": "Pick waste at bin_disposal",
            "action": "pick",
            "params": {
              "object": "waste"
            },
            "outputs": {
              "status": "pick_bin_status"
            }
          }
        ]
      },
      {
        "name": "No waste found anywhere - graceful success",
        "type": "condition",
        "key": "no_waste_found",
        "operator": "==",
        "value": true
      }
    ]
  },
  "blackboard": {
    "initial": {
      "no_waste_found": true
    }
  }
}