{
  "root": {
    "type": "sequence",
    "memory": true,
    "children": [
      {
        "name": "Find and pick snacks (pantry first, then desk)",
        "type": "selector",
        "memory": true,
        "children": [
          {
            "name": "Search pantry for snacks",
            "type": "sequence",
            "memory": true,
            "children": [
              {
                "name": "Navigate to pantry",
                "type": "action",
                "action": "navigate",
                "params": {
                  "target_location": "pantry"
                }
              },
              {
                "name": "Open pantry",
                "type": "action",
                "action": "open"
              },
              {
                "name": "Detect snacks at pantry",
                "type": "action",
                "action": "detect",
                "params": {
                  "object": "snacks"
                },
                "outputs": {
                  "detected_objects": "detected_pantry"
                }
              },
              {
                "name": "Snacks found at pantry?",
                "type": "condition",
                "key": "detected_pantry",
                "operator": "truthy",
                "value": true
              },
              {
                "name": "Pick snacks from pantry",
                "type": "action",
                "action": "pick",
                "params": {
                  "object": "snacks"
                }
              }
            ]
          },
          {
            "name": "Search desk for snacks",
            "type": "sequence",
            "memory": true,
            "children": [
              {
                "name": "Close pantry (not holding anything)",
                "type": "action",
                "action": "close",
                "params": {
                  "target_location": "pantry"
                }
              },
              {
                "name": "Navigate to desk_desktop",
                "type": "action",
                "action": "navigate",
                "params": {
                  "target_location": "desk_desktop"
                }
              },
              {
                "name": "Detect snacks at desk",
                "type": "action",
                "action": "detect",
                "params": {
                  "object": "snacks"
                },
                "outputs": {
                  "detected_objects": "detected_desk"
                }
              },
              {
                "name": "Snacks found at desk?",
                "type": "condition",
                "key": "detected_desk",
                "operator": "truthy",
                "value": true
              },
              {
                "name": "Pick snacks from desk",
                "type": "action",
                "action": "pick",
                "params": {
                  "object": "snacks"
                }
              }
            ]
          }
        ]
      },
      {
        "name": "Navigate to table_tabletop",
        "type": "action",
        "action": "navigate",
        "params": {
          "target_location": "table_tabletop"
        }
      },
      {
        "name": "Place snacks on table",
        "type": "action",
        "action": "place"
      }
    ]
  }
}